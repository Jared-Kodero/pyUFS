#!/bin/bash

# Native runs load host modules; make the module command available in this
# non-interactive shell when the environment does not provide it.
if [ -n "__MODULES__" ] && ! type module >/dev/null 2>&1; then
    for init in /etc/profile.d/lmod.sh /etc/profile.d/modules.sh; do
        if [ -f "$init" ]; then
            . "$init"
            break
        fi
    done
fi

__MODULES__

export OMP_NUM_THREADS=1
export OMP_DYNAMIC=FALSE
# Open MPI session directories on node-local /tmp (TMPDIR may be on a shared
# filesystem); ignored by srun-launched native runs.
export OMPI_MCA_orte_tmpdir_base="${OMPI_MCA_orte_tmpdir_base:-/tmp}"

# FV3 keeps large automatic arrays on the stack; the default 8 MB limit can
# crash gfortran builds (the SHiELD container is run with --ulimit stack=-1).
# srun propagates this limit to the ranks.
ulimit -s unlimited 2>/dev/null || ulimit -s "$(ulimit -H -s)" 2>/dev/null || true

cd "__WORK_DIR__" || exit 1





start_time=$(date +%s)

__LAUNCHER__ __TOTAL_PES__ __EXECUTABLE__ > __LOG_FILE__ 2>&1
exit_code=$?
echo "$exit_code" > __EXIT_CODE_FILE__

if [ "$exit_code" -ne 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M') - GFDL SHIELD - ERROR - Model execution failed, see logs!"
else
    end_time=$(date +%s)
    elapsed_hours=$(awk -v start="$start_time" -v end="$end_time" \
        'BEGIN {printf "%.2f", (end - start)/3600}')

    echo "$(date '+%Y-%m-%d %H:%M') - GFDL SHIELD - INFO - Finished in: $elapsed_hours hours"
fi

wait
exit "$exit_code"