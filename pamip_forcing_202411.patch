+            name = f"{spec['variable_id']}_input4MIPs_SSTsAndSeaIce_PAMIP_{spec['source_id']}_gn_{spec['period']}.nc"
+            pairs.add((spec["source_id"], spec["variable_id"], name))
+    return sorted(pairs)
